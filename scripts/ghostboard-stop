# Stop the GHOSTBOARD, first copying what the board wrote to flash back into the workspace.
#   ghostboard-stop [--discard]
set -uo pipefail
. "$(dirname "$(readlink -f "$0")")/ghostboard-common.sh"
if [ -z "$(gb_pids)" ]; then echo "GHOSTBOARD was not running"; exit 0; fi
if [ "${1:-}" = "--discard" ]; then gb_stop; else gb_stop save; fi
echo "GHOSTBOARD stopped"
