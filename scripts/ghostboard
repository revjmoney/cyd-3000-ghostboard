#!/bin/bash
# SPDX-License-Identifier: GPL-2.0-only
# Copyright (C) 2026 Rev. J. Money
#
# Start the CYD-3000 GHOSTBOARD: an emulated ESP32 Cheap Yellow Display on this desktop.
#   ghostboard [--fresh] [--no-forward]
#     --fresh       don't keep what a running board wrote to flash (default: copy it back first)
#     --no-forward  no host port forwards
# Forwards (host -> board): tcp 2323 -> 23 (telnet), udp 2325 -> 2325 (AXIS cluster announcements).
# The board's serial output goes to $GHOSTBOARD_HOME/serial.log as well as the on-screen terminal.
set -uo pipefail
. "$(dirname "$(readlink -f "$0")")/ghostboard-common.sh"
REPO="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"

fresh=0; forward=1
for a in "$@"; do
    case "$a" in
        --fresh) fresh=1 ;;
        --no-forward) forward=0 ;;
        -h|--help) sed -n '5,10p' "$0"; exit 0 ;;
        *) echo "unknown option $a"; exit 1 ;;
    esac
done

[ -x "$PS/AppRun" ] || { echo "PICSimLab is not set up in $PS: run scripts/setup.sh first"; exit 1; }
command -v zip >/dev/null || { echo "zip is needed (sudo apt install zip)"; exit 1; }

# first start: the board template, an empty 4 MB flash, a 256 MB SD card
if [ ! -f "$WS/picsimlab.ini" ]; then
    mkdir -p "$WS"
    cp "$REPO/board/cyd/picsimlab.ini" "$REPO/board/cyd/palias_ESP32_DevKitC.ppa" "$WS/"
    sd="$GH/sd.img"
    if [ ! -f "$sd" ] && command -v mkfs.fat >/dev/null; then
        truncate -s 256M "$sd" && mkfs.fat -F 32 -n GHOSTSD "$sd" >/dev/null && echo "made a blank 256 MB SD card: $sd"
    fi
    if [ -f "$sd" ]; then
        sed -e "s|@SDIMG@|$sd|" -e "s|@SERIALLOG@|$GH/serial.log|" "$REPO/board/cyd/parts_ESP32_DevKitC.pcf" > "$WS/parts_ESP32_DevKitC.pcf"
    else
        echo "no SD card (mkfs.fat not found: sudo apt install dosfstools, then delete $WS to start over)"
        grep -v '^SD Card,' "$REPO/board/cyd/parts_ESP32_DevKitC.pcf" | sed "s|@SERIALLOG@|$GH/serial.log|" > "$WS/parts_ESP32_DevKitC.pcf"
    fi
fi
[ -f "$FLASH" ] || head -c 4194304 /dev/zero | tr '\0' '\377' > "$FLASH"

[ $fresh -eq 1 ] || gb_save_live
gb_kill
sleep 1
gb_pack

# a desktop session, also when started over ssh
export DISPLAY="${DISPLAY:-:0}"
if [ -z "${XAUTHORITY:-}" ]; then
    xa=$(ls /run/user/"$(id -u)"/.mutter-Xwaylandauth.* 2>/dev/null | head -1)
    [ -n "$xa" ] && export XAUTHORITY="$xa"
fi
[ -d /run/user/"$(id -u)" ] && export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
[ -S /run/user/"$(id -u)"/bus ] && export DBUS_SESSION_BUS_ADDRESS="${DBUS_SESSION_BUS_ADDRESS:-unix:path=/run/user/$(id -u)/bus}"
export GDK_BACKEND=x11            # PICSimLab's bundled GTK has no Wayland: run on Xwayland
export GDK_CORE_DEVICE_EVENTS=1   # so scripts/tap can click the screen
: > "$GH/serial.log"
setsid nohup "$PS/AppRun" "$PZW" > "$GH/picsimlab.log" 2>&1 < /dev/null &

for _ in $(seq 1 40); do
    ss -ltn 2>/dev/null | grep -q "127.0.0.1:$MONITOR_PORT " && break
    sleep 1
done
ss -ltn 2>/dev/null | grep -q "127.0.0.1:$MONITOR_PORT " || { echo "the emulator did not start: see $GH/picsimlab.log"; exit 1; }

if [ $forward -eq 1 ]; then
    for f in "tcp 2323 23" "udp 2325 2325"; do
        set -- $f
        if { [ "$1" = tcp ] && ss -ltn | grep -q ":$2 "; } || { [ "$1" = udp ] && ss -lun | grep -q ":$2 "; }; then
            echo "host $1 port $2 is taken: no forward to the board's port $3"
            continue
        fi
        python3 - "$MONITOR_PORT" "hostfwd_add u1 $1::$2-:$3" <<'P'
import socket, sys, time
s = socket.create_connection(("127.0.0.1", int(sys.argv[1])), timeout=5)
time.sleep(0.5); s.recv(65536)
s.sendall(sys.argv[2].encode() + b"\n"); time.sleep(0.7); s.recv(65536)
P
        echo "forward: host $1 $2 -> board $3"
    done
fi
echo "GHOSTBOARD running (serial log: $GH/serial.log)"
